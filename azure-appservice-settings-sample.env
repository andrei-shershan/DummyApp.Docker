# Azure App Service Configuration / Key Vault sample values
# Use this as a template for App Service Application Settings or Key Vault secret names.
# Format: Section__Subsection__Key=value
# Array items are represented by numeric indexes, e.g. DefaultUsers__0__Email.

IdentityServer__Authority=https://identity.dummy.localhost
IdentityServer__Audiences__0=DummyApp.StorageService
IdentityServer__OidcClients__BFF__ClientId=bff-client
IdentityServer__OidcClients__BFF__ClientSecret=secret
IdentityServer__OidcClients__BFF__RedirectUri=https://bff.dummy.localhost/signin-oidc
IdentityServer__OidcClients__BFF__PostLogoutRedirectUri=https://bff.dummy.localhost/signout-callback-oidc
IdentityServer__OidcClients__BFF__MetadataAddress=http://identity:8080/.well-known/openid-configuration
IdentityServer__OidcClients__ApiGateway__ClientId=storage-client
IdentityServer__OidcClients__ApiGateway__ClientSecret=storage-secret
IdentityServer__OidcClients__ApiGateway__DisplayName=Storage service client

Services__Frontend__BaseUrl=https://fe.dummy.localhost
Services__BFF__BaseUrl=https://bff.dummy.localhost
Services__ApiGateway__BaseUrl=https://apigateway.dummy.localhost
Services__StorageService__BaseUrl=https://storage.dummy.localhost
Services__StorageService__Audience=DummyApp.StorageService
Services__BlobService__BaseUrl=https://blobservice.dummy.localhost
BlobStorage__ConnectionString=DefaultEndpointsProtocol=https;AccountName=<account>;AccountKey=<key>;EndpointSuffix=core.windows.net
BlobStorage__ContainerName=artworks
BlobStorage__StorageUrl=https://<storage-account>.blob.core.windows.net
BlobStorage__SecretKey=123123
AzureWebJobsStorage=DefaultEndpointsProtocol=https;AccountName=<account>;AccountKey=<key>;EndpointSuffix=core.windows.net
Services__IdentityService__BaseUrl=https://identity.dummy.localhost
Services__EmailService__BaseUrl=https://emailservice.dummy.localhost
EmailService__SecretKey=123123

# Stripe payment configuration
Stripe__SecretKey=<stripe-secret-key>
Stripe__WebhookSecret=<stripe-webhook-secret>

Stripe__SuccessUrl=https://fe.dummy.localhost/checkout/success
Stripe__CancelUrl=https://fe.dummy.localhost/basket

Application__SiteId=local

ServiceBus__ConnectionString=Endpoint=sb://<namespace>.servicebus.windows.net/;SharedAccessKeyName=<key-name>;SharedAccessKey=<key>
ServiceBus__PaymentEventsQueueName=payment-events

Infrastructure__Databases__Identity__UseInMemory=false
Infrastructure__Databases__Identity__ConnectionString=server=mysql;port=3306;database=dummy_identity;user=dummyapp;password=secret
Infrastructure__Databases__Storage__UseInMemory=true
Infrastructure__Databases__Storage__ConnectionString=server=mysql;port=3306;database=dummy_db;user=dummyapp;password=secret
Infrastructure__Databases__Storage__SeedPricesAndSizes=true

FeatureFlags__DefaultRolesSeed=false
FeatureFlags__DefaultUsersSeed=false

DefaultUsers__0__Email=admin@dummy.localhost
DefaultUsers__0__Password=Admin123!
DefaultUsers__0__Role=Admin
DefaultUsers__0__FirstName=Admin
DefaultUsers__0__LastName=User
DefaultUsers__1__Email=moderator@dummy.localhost
DefaultUsers__1__Password=Moderator123!
DefaultUsers__1__Role=Moderator
DefaultUsers__1__FirstName=Moderator
DefaultUsers__1__LastName=User
DefaultUsers__2__Email=customer@dummy.localhost
DefaultUsers__2__Password=Customer123!
DefaultUsers__2__Role=Customer
DefaultUsers__2__FirstName=Customer
DefaultUsers__2__LastName=User
DefaultUsers__3__Email=creator@dummy.localhost
DefaultUsers__3__Password=Creator123!
DefaultUsers__3__Role=Creator
DefaultUsers__3__FirstName=Creator
DefaultUsers__3__LastName=User

Cors__AllowedOrigins__0=https://fe.dummy.localhost

ReverseProxy__TrustAllProxies=false
ReverseProxy__Routes__api_route__ClusterId=api_cluster
ReverseProxy__Routes__api_route__Match__Path=/api/{**catch-all}
ReverseProxy__Clusters__api_cluster__Destinations__api1__Address=https://apigateway.dummy.localhost/

KeyVault__Url=

Logging__LogLevel__Default=Information
Logging__LogLevel__Microsoft.AspNetCore=Warning
AllowedHosts=*
